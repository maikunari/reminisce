# ---------------------------------------------------------------------------
# Reminisce environment variables
# Copy to .env.local for local development. Never commit real keys.
# ---------------------------------------------------------------------------

# Qloo hackathon API (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# "live"    -> call https://hackathon.api.qloo.com with QLOO_API_KEY
# "fixture" -> serve recorded responses from fixtures/recorded (falls back to the
#              synthetic catalog in fixtures/synthetic when nothing is recorded)
# Leave unset to auto-select: live when QLOO_API_KEY is present, fixture otherwise.
QLOO_MODE=fixture
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# The model that writes each card's conversation prompt once the deck is dealt.
# LLM_BASE_URL=https://api.anthropic.com/v1 uses Anthropic's Messages API
# (e.g. LLM_MODEL=claude-haiku-4-5); any other base URL is called as an
# OpenAI-compatible /chat/completions endpoint with tool calling (OpenAI,
# OpenRouter, Groq, Together, local servers...).
# "live"    -> call the model
# "fixture" -> no model call; cards keep their template prompts
# Leave unset to auto-select: live when LLM_API_KEY is present, fixture otherwise.
LLM_MODE=fixture
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Keeping the public demo affordable (all optional; see README "Keeping the
# demo affordable"). With no Redis configured there is no daily budget and no
# preset snapshots: every request runs exactly as it would locally.
# ---------------------------------------------------------------------------

# Upstash Redis (free via the Vercel Marketplace). The integration injects one
# of these pairs; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Global daily caps (UTC days). A whole number sets the cap, "unlimited" removes it.
# When the model cap is spent, sessions keep their template prompts; when
# the Qloo cap is spent, sessions come from the offline catalog with a note
# in the header. Never an error page.
BUDGET_LLM_PLANS_PER_DAY=40
BUDGET_LLM_ADAPTS_PER_DAY=120
BUDGET_QLOO_CALLS_PER_DAY=600

# Vercel BotID (Basic, free) guards /api/plan and /api/adapt on Vercel.
# Set to "off" (and redeploy) to disable it on both client and server.
# NEXT_PUBLIC_BOTID=off
