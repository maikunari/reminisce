# ---------------------------------------------------------------------------
# Reminisce environment variables
# Copy to .env.local for local development. Never commit real keys.
# ---------------------------------------------------------------------------

# Qloo hackathon API (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# "live"    -> call https://hackathon.api.qloo.com with QLOO_API_KEY
# "fixture" -> serve recorded responses from fixtures/recorded (falls back to the
#              synthetic catalog in fixtures/synthetic when nothing is recorded)
# Leave unset to auto-select: live when QLOO_API_KEY is present, fixture otherwise.
QLOO_MODE=fixture
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Fixture mode only: simulated latency per Qloo call (ms) so the agent trace
# paces like the real API in demos. Set 0 for instant responses (tests do).
QLOO_FIXTURE_LATENCY_MS=250

# OpenAI-compatible LLM used by the agent to narrate planning and write
# conversation prompts. Any provider that speaks /v1/chat/completions with
# function calling works (OpenAI, OpenRouter, Groq, Together, local servers...).
# "live"    -> call the model
# "fixture" -> deterministic offline planner (no network)
# Leave unset to auto-select: live when LLM_API_KEY is present, fixture otherwise.
LLM_MODE=fixture
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
